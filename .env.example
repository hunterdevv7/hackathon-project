# Copy this file to .env and fill in values. Never commit .env.

# "quantumrings" = real Quantum Rings engine (needs QR_TOKEN and QR_ACCOUNT below).
# "mock" = placeholder randomness, only for frontend work without credentials.
QUANTUM_MODE=quantumrings

# Default number of bits per draw (both panels return the same shape)
BATCH_SIZE=64

PORT=5000

# Browser origins allowed to call the API from another site (CORS). Leave it unset
# in production: the API serves the page itself, so they share an origin. Only for
# frontend work from a separate dev server or a file:// page, set CORS_ORIGINS=*
# CORS_ORIGINS=

# Quantum Rings credentials (needed for QUANTUM_MODE=quantumrings).
# QR_TOKEN = license token from your Quantum Rings account; QR_ACCOUNT = the email you registered with.
QR_TOKEN=
QR_ACCOUNT=
# Optional: backend name (default scarlet_quantum_rings)
# QR_BACKEND=scarlet_quantum_rings
