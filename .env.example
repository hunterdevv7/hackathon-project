# Copy this file to .env and fill in values. Never commit .env.

# "mock" = placeholder randomness (frontend dev). "quantumrings" = real Quantum Rings engine.
QUANTUM_MODE=mock

# Default number of bits per draw (both panels return the same shape)
BATCH_SIZE=64

PORT=5000

